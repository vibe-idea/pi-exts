{
  "name": "pi-exit",
  "version": "0.1.0",
  "description": "Adds /exit as a graceful alias for Pi's /quit command.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi"
  ],
  "files": [
